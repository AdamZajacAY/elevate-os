{
  "name": "elevate-os",
  "version": "0.1.0",
  "description": "ELEVATE OS — platforma projektowa, finansowa i CRM zespolu doradczego AdviseYou",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run backup && node ./node_modules/next/dist/bin/next dev --port 3002",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/prisma/build/index.js migrate deploy && node ./node_modules/next/dist/bin/next start -p ${PORT:-3002}",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:reset": "node ./node_modules/prisma/build/index.js db push --force-reset && npm run db:seed",
    "backup": "node ./node_modules/tsx/dist/cli.mjs scripts/startup-backup.ts",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:bootstrap": "node ./node_modules/tsx/dist/cli.mjs scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/pg": "^8.11.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
